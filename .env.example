# ChessBench Environment Configuration Example
# Copy this file to `.env` and fill in your API keys as needed.

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
NIM_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=

# Engine Configuration
STOCKFISH_PATH=/usr/games/stockfish

# Storage & Hosted Settings
CHESSBENCH_RUNS_ROOT=runs
CHESSBENCH_HOSTED_PROVIDERS=openrouter,nim
