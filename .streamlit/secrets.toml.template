# Streamlit secrets template for Chess Fight
# Copy this file to .streamlit/secrets.toml and fill in your API keys
# For Streamlit Cloud: add these in Settings > Secrets

# ============================================================================
# LLM Provider API Keys (at least one required for live games)
# ============================================================================

# OpenRouter - 100+ models, free tier available (recommended for demo)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-your_openrouter_key_here"

# OpenAI - GPT-4o, o1, etc.
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY = "sk-your_openai_key_here"

# Anthropic - Claude models
# Get key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY = "sk-ant-your_anthropic_key_here"

# Google AI - Gemini models
# Get key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY = "your_google_ai_key_here"

# Groq - Fast inference, generous free tier
# Get key at: https://console.groq.com/keys
# GROQ_API_KEY = "gsk-your_groq_key_here"

# NVIDIA NIM - Hosted Llama/Qwen/Mistral
# Get key at: https://build.nvidia.com/explore/discover
# NIM_API_KEY = "your_nim_key_here"

# ============================================================================
# Local Provider Base URLs (no API key required)
# ============================================================================

# Ollama - Local models (run `ollama serve` first)
# Default: http://localhost:11434
# OLLAMA_BASE_URL = "http://localhost:11434"

# Groq base URL (usually no need to change)
# GROQ_BASE_URL = "https://api.groq.com/openai/v1"

# NVIDIA NIM base URL (usually no need to change)
# NIM_BASE_URL = "https://integrate.api.nvidia.com/v1"

# ============================================================================
# Notes
# ============================================================================
# - Only ONE provider API key is required to run the app
# - OpenRouter is recommended for the hosted demo (free tier available)
# - Stockfish (local engine) requires NO API key - just install via packages.txt
# - For local development, you can also use a .env file instead of secrets.toml